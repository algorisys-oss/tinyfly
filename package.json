{
  "name": "tinyfly",
  "version": "0.26.0",
  "type": "module",
  "description": "Lightweight, API-driven animation engine and editor. The engine is framework-agnostic and runs in browsers, Web Workers, and Node.",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./lib/engine/tinyfly-engine.umd.cjs",
  "module": "./lib/engine/tinyfly-engine.js",
  "types": "./lib/types/engine/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/engine/index.d.ts",
      "import": "./lib/engine/tinyfly-engine.js",
      "require": "./lib/engine/tinyfly-engine.umd.cjs"
    },
    "./player": {
      "types": "./lib/types/player/index.d.ts",
      "import": "./lib/player/tinyfly-player.es.js",
      "require": "./lib/player/tinyfly-player.umd.js"
    }
  },
  "files": [
    "lib/engine",
    "lib/player",
    "lib/types"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:player": "vite build --config vite.config.player.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@solidjs/router": "^0.15.4",
    "solid-js": "^1.9.10"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "happy-dom": "^20.5.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.0.18"
  }
}
