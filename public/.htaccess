# Apache / LiteSpeed (Hostinger and most shared hosting).
#
# tinyfly is a single-page app: /studio, /learn/…, /examples/…, /docs/… are
# addresses inside the app, not files. Answer anything that isn't a real file
# with index.html, so opening or refreshing those pages works.

Options -MultiViews -Indexes
DirectoryIndex index.html
# /docs is a folder (the markdown docs) and a page of the app. Don't redirect it to
# /docs/ just because the folder exists; let the rewrite below send it to the app.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # Real files (assets, llms.txt, docs/*.md) are served as themselves.
  RewriteCond %{REQUEST_FILENAME} !-f
  # Directories are not excluded on purpose: /docs is both a folder of markdown
  # files and a page of the app, and the page must win.
  RewriteRule ^ index.html [L]
</IfModule>

# Without mod_rewrite, fall back to the app for missing pages.
ErrorDocument 404 /index.html

# The docs for language models are text, not downloads.
AddType text/markdown;charset=utf-8 .md
AddType text/plain;charset=utf-8 .txt

# Hashed build assets never change; the HTML always revalidates.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
